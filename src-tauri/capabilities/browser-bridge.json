{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "browser-bridge",
  "description": "Allows embedded browser webviews to return controlled DOM bridge results",
  "windows": [
    "main"
  ],
  "webviews": [
    "sparky-ide-*"
  ],
  "remote": {
    "urls": [
      "http://localhost:*/*",
      "http://127.0.0.1:*/*",
      "https://*/*"
    ]
  },
  "permissions": [
    "browser-bridge:allow-browser-bridge-response",
    "browser-bridge:allow-browser-debug-log",
    "browser-bridge:allow-browser-link-open"
  ]
}
