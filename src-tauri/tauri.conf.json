{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Sparky",
  "version": "2.0.0",
  "identifier": "com.sparky.desktop",
  "build": {
    "frontendDist": "../ui/dist",
    "devUrl": "http://localhost:51760",
    "beforeDevCommand": "UI_DIR=ui; [ -d $UI_DIR ] || UI_DIR=../ui; npm --prefix $UI_DIR run dev -- --host 127.0.0.1 --port 51760",
    "beforeBuildCommand": "ROOT_DIR=.; [ -f $ROOT_DIR/src/bin/sparky-server.rs ] || ROOT_DIR=..; cargo build --release --bin sparky-server --manifest-path $ROOT_DIR/Cargo.toml && cp -f $ROOT_DIR/target/release/sparky-server $ROOT_DIR/target/release/sparky-server-aarch64-apple-darwin || true && UI_DIR=ui; [ -d $UI_DIR ] || UI_DIR=../ui; npm --prefix $UI_DIR run build"
  },
  "app": {
    "windows": [
      {
        "title": "Sparky",
        "width": 1440,
        "height": 900,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "../target/release/sparky-server"
    ],
    "resources": [
      "extensions"
    ]
  }
}